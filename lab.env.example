# Copy to lab.env. This is a single-server lab; M3UNDLE_LAB_ROLE is retired.
# Generic LAB_* AI/artifact settings are documented in se-lab/lab.env.example.

# Optional fork/mirror override. The plugin defaults to Sydney-Elvis/M3Undle.
# M3UNDLE_REPO_URL=https://github.com/Sydney-Elvis/M3Undle.git

# Needed only for `lab pull <tag>` in a later slice.
# M3UNDLE_GHCR_IMAGE=ghcr.io/sydney-elvis/m3undle

# Optional runtime location. Default: a sibling `m3undle/` directory beside this checkout.
# M3UNDLE_RUNTIME_DIR=/opt/m3undle-lab-v2-runtime

# Required for the host-network automated topology. Use this host's stable LAN IP,
# never a physical HDHomeRun device address.
M3UNDLE_HDHR_ADVERTISED_BASE_URL=http://192.168.1.50:5004

# Optional; used by `lab run` and `lab status` when the host is not localhost.
# M3UNDLE_BASE_URL=http://127.0.0.1:8080

# Required for reusable settings fixtures. Generate once with: openssl rand -base64 32.
# Keep this lab-only value stable across `lab run --fresh` cycles; never use a production key.
# M3UNDLE_ENCRYPTION_KEY=replace-with-generated-key

# Optional AI analysis configuration (all LAB_* settings are optional).
# LAB_LITELLM_URL=http://your-litellm-host:4000/v1
# LITELLM_KEY=replace-with-your-litellm-key

# Optional image overrides for `lab clients up/update/rollback/pin`. Defaults shown.
# JELLYFIN_IMAGE=jellyfin/jellyfin
# NEXTPVR_IMAGE=nextpvr/nextpvr_amd64
